{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gylio-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 3001
    },
    {
      "name": "gylio-web-noauth",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:noauth"
      ],
      "port": 5174
    },
    {
      "name": "gylio-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}