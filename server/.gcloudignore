# What `gcloud run deploy --source server` uploads to Cloud Build.
# Without this file gcloud would upload server/.env (Clerk secret key) and the
# local SQLite database: the repository's .gitignore is not read for a subfolder.
.gcloudignore
.env
.env.*
*.db
*.db-journal
node_modules/
coverage/
*.test.js
*.test.ts
