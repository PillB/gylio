# GYLIO API configuration
#
# Hostinger: configure these in hPanel as environment variables. Do not commit
# real credentials. Local developers may copy this file to server/.env.

NODE_ENV=development
PORT=3001

# Production persistence. Required whenever NODE_ENV=production.
# Recommended initial deployment: MongoDB Atlas Free cluster.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gylio?retryWrites=true&w=majority

# Browser origins allowed to call the API. Comma-separated, exact origins only.
# Production example: https://app.example.com
CORS_ORIGINS=http://localhost:5173

# Clerk JWT verification.
# Use the issuer/front-end API URL for the Clerk application.
CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
# Optional override; otherwise derived as ${CLERK_ISSUER}/.well-known/jwks.json
CLERK_JWKS_URL=
# Comma-separated allowed token authorized parties (azp).
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Optional AI feature. If omitted, AI endpoints return service-unavailable while
# the rest of the product continues to work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Development-only billing test helpers. Keep disabled in production.
ENABLE_MANUAL_TRIALS=false
CLERK_SECRET_KEY=
