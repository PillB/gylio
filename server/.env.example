# Clerk (https://clerk.com → Dashboard → API Keys)
# Replace with your actual key from the Clerk dashboard
CLERK_SECRET_KEY=<your_clerk_secret_key>
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_HEX

# Optional
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
MONGODB_URI=mongodb://localhost:27017/gylio
PORT=3001
OPENAI_API_KEY=<your_openai_api_key>
OPENAI_MODEL=gpt-4o-mini
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
AUTH_RATE_LIMIT_MAX=20
MUTATION_RATE_LIMIT_MAX=120
PASSWORD_HASH_ROUNDS=12
