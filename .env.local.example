# GYLIO web/PWA configuration
#
# Copy to .env.local for local development. Never place server secrets in a
# VITE_* variable: Vite embeds these values into the public browser bundle.

# Clerk browser publishable key (public by design).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_key_here

# API origin without a trailing slash.
# Leave blank locally to use the Vite /api proxy to http://localhost:3001.
# Firebase production example: https://api.example.com
VITE_API_BASE_URL=

# Firebase/root hosting uses /. GitHub Pages uses /gylio/.
VITE_BASE_PATH=/

# Keep false until a real production checkout/subscription lifecycle is wired.
VITE_BILLING_ENABLED=false
