{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "expo-av": ["src/shims/expo-av.ts"],
      "expo-modules-core": ["src/shims/expo-modules-core.ts"],
      "expo-notifications": ["src/shims/expo-notifications.ts"],
      "expo-speech": ["src/shims/expo-speech.ts"],
      "expo-sqlite": ["src/shims/expo-sqlite.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js", "src/**/*.jsx"],
  "exclude": ["src/service-worker.ts"]
}
